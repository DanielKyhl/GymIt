# Copy this file to .env and fill in the values from:
# Firebase console -> Project settings (gear icon) -> Your apps -> Web app -> SDK setup and configuration
# These identify your project; they are not secret (access is controlled by firestore.rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: develop against the local emulators instead of the real project.
# Start them with: npx firebase-tools emulators:start --project demo-gymit
# EXPO_PUBLIC_USE_EMULATORS=1
# On a phone, set this to your laptop's LAN IP instead of 127.0.0.1:
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20
